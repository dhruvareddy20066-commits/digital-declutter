PORT=5000
# Local MongoDB (default)
MONGO_URI=mongodb://localhost:27017/digital_declutter
# Optional: MongoDB Atlas fallback, used automatically if the local connection fails
# MONGO_URI_FALLBACK=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/digital_declutter
NODE_ENV=development
# Optional: allowed browser origin for CORS
CLIENT_ORIGIN=http://localhost:5173
